# BaToPay Environment Example
# Copy values into config via Installer / Admin Panel.
# Do NOT put real secrets in this file.

APP_URL=https://pay.example.com
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=batopay
DB_USERNAME=batopay_user
DB_PASSWORD=change_me

# Encryption key is generated during install into storage/secure/key.php
# CUBEPAY_TOKEN and BLUPAL_API_KEY are managed from Admin Panel (encrypted in DB)
# TELEGRAM_BOT_TOKEN is managed from Admin Panel (encrypted in DB)
